apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ redis_configmap_name }}
  namespace: {{ redis_namespace }}
  labels:
{% set appendonly_mount = redis_ephemeral_mounts.get('appendonlydir', {}) %}
{% set appendonly_enabled = appendonly_mount.get('enabled', False) %}
{% set appendonly_k8s = appendonly_mount.get('kubernetes', {}) %}
{% set appendonly_fs_tmpfs = appendonly_k8s.get('medium', '') | lower == 'memory' %}
{% set appendfsync_value = 'no' if appendonly_fs_tmpfs else redis_appendfsync %}
{% set acl_secret_path = '/opt/bitnami/redis/mounted-etc/users.acl' %}
{% set tls_cert_path = redis_tls_mount_path %}
{% set redis_port_value = redis_port if redis_enable_plaintext_port else 0 %}
{% set tls_health_extra_flags = '--insecure ' if redis_tls_healthcheck_skip_verify else '' %}
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
data:
  redis.conf: |
    bind 0.0.0.0
    port {{ redis_port_value }}
    protected-mode yes
    tcp-keepalive {{ redis_tcp_keepalive }}
    timeout {{ redis_timeout }}
    tcp-backlog {{ redis_tcp_backlog }}
    dir {{ redis_kubernetes_data_dir }}
{% if appendonly_enabled and redis_appendonlydir_name %}
    appenddirname {{ redis_appendonlydir_name }}
{% endif %}
    appendonly {{ 'yes' if redis_persistence_enabled else 'no' }}
{% if appendonly_fs_tmpfs %}
    # appendfsync overridden because appendonlydir uses memory-backed storage
{% endif %}
    appendfsync {{ appendfsync_value }}
    maxmemory {{ redis_maxmemory }}
    maxmemory-policy {{ redis_maxmemory_policy }}
    maxclients {{ redis_maxclients }}
    lua-time-limit {{ redis_lua_time_limit }}
    slowlog-log-slower-than {{ redis_slowlog_log_slower_than }}
    slowlog-max-len {{ redis_slowlog_max_len }}
{% for cmd in redis_disable_dangerous_commands %}
    rename-command {{ cmd }} ""
{% endfor %}
{% if not redis_persistence_enabled %}
    save ""
{% endif %}
{% if redis_persistence_enabled and redis_save_points %}
{% for save in redis_save_points %}
    save {{ save.seconds }} {{ save.changes }}
{% endfor %}
{% endif %}
{% if redis_acl_enabled %}
    aclfile {{ acl_secret_path }}
{% endif %}
{% if redis_tls_enabled %}
    tls-port {{ redis_tls_port }}
    tls-cert-file {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }}
    tls-key-file {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }}
    tls-ca-cert-file {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }}
    tls-auth-clients {{ redis_tls_auth_clients }}
    tls-replication yes
    tls-cluster yes
{% else %}
    tls-port 0
{% endif %}
{% for line in redis_additional_config %}
    {{ line }}
{% endfor %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ redis_statefulset_name }}
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  replicas: {{ redis_replicas }}
  serviceName: {{ redis_headless_service_name }}
  selector:
    matchLabels:
{% for key, value in redis_labels.items() %}
      {{ key }}: {{ value }}
{% endfor %}
  template:
    metadata:
      labels:
{% for key, value in redis_labels.items() %}
        {{ key }}: {{ value }}
{% endfor %}
    spec:
      securityContext:
        fsGroup: 1001
        runAsUser: 1001
        runAsNonRoot: true
      containers:
        - name: redis
          image: {{ redis_image }}
          imagePullPolicy: {{ redis_image_pull_policy }}
          command:
            - redis-server
            - /opt/bitnami/redis/mounted-etc/redis.conf
          env:
            - name: REDIS_PASSWORD_FILE
              value: /run/redis-password/password
            - name: ALLOW_EMPTY_PASSWORD
              value: "no"
            - name: REDIS_HOST
              value: "{{ redis_service_name }}"
            - name: REDIS_PORT
              value: "{{ (redis_tls_port if redis_tls_enabled and not redis_enable_plaintext_port else redis_port) | string }}"
{% if redis_tls_enabled %}
            - name: REDIS_TLS_ENABLED
              value: "yes"
            - name: REDIS_TLS_PORT
              value: "{{ redis_tls_port | string }}"
            - name: REDIS_TLS_CERT_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }}
            - name: REDIS_TLS_KEY_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }}
            - name: REDIS_TLS_CA_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }}
            - name: REDIS_TLS_AUTH_CLIENTS
              value: {{ redis_tls_auth_clients | quote }}
{% endif %}
          ports:
{% if redis_enable_plaintext_port %}
            - name: redis
              containerPort: {{ redis_port }}
{% endif %}
{% if redis_tls_enabled %}
            - name: redis-tls
              containerPort: {{ redis_tls_port }}
{% endif %}
          volumeMounts:
            - name: redis-config
              mountPath: /opt/bitnami/redis/mounted-etc
            - name: redis-password
              mountPath: /run/redis-password
              readOnly: true
{% if redis_acl_enabled %}
            - name: redis-acl
              mountPath: {{ acl_secret_path }}
              subPath: users.acl
              readOnly: true
{% endif %}
{% if redis_tls_enabled %}
            - name: redis-tls
              mountPath: {{ tls_cert_path }}
              readOnly: true
{% endif %}
            - name: redis-data
              mountPath: {{ redis_kubernetes_data_dir }}
{% if appendonly_enabled and redis_appendonlydir_name %}
            - name: redis-appendonlydir
              mountPath: {{ redis_kubernetes_data_dir }}/{{ redis_appendonlydir_name }}
{% endif %}
          resources:
{{ redis_resources | to_nice_yaml(indent=12) | indent(10, False) }}
          livenessProbe:
            exec:
              command:
                - sh
                - -c
                - >-
                  REDIS_PASSWORD="$(cat /run/redis-password/password)" &&
{% if redis_tls_enabled %}
                  redis-cli --tls {{ tls_health_extra_flags }}--cert {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }} --key {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }} --cacert {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }} -a "$REDIS_PASSWORD" -h 127.0.0.1 -p {{ redis_tls_port }} ping
{% else %}
                  redis-cli -a "$REDIS_PASSWORD" -h 127.0.0.1 -p {{ redis_port }} ping
{% endif %}
            initialDelaySeconds: 30
            periodSeconds: 30
            timeoutSeconds: 5
          readinessProbe:
            exec:
              command:
                - sh
                - -c
                - >-
                  REDIS_PASSWORD="$(cat /run/redis-password/password)" &&
{% if redis_tls_enabled %}
                  redis-cli --tls {{ tls_health_extra_flags }}--cert {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }} --key {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }} --cacert {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }} -a "$REDIS_PASSWORD" -h 127.0.0.1 -p {{ redis_tls_port }} ping | grep -q PONG
{% else %}
                  redis-cli -a "$REDIS_PASSWORD" -h 127.0.0.1 -p {{ redis_port }} ping | grep -q PONG
{% endif %}
            initialDelaySeconds: 5
            periodSeconds: 10
            timeoutSeconds: 3
{% if redis_enable_metrics %}
        - name: {{ redis_name }}-exporter
          image: {{ redis_metrics_image }}
          ports:
            - name: metrics
              containerPort: 9121
          env:
            - name: REDIS_ADDR
              value: {{ 'rediss' if redis_tls_enabled else 'redis' }}://127.0.0.1:{{ (redis_tls_port if redis_tls_enabled else redis_port) | string }}
            - name: REDIS_PASSWORD_FILE
              value: /run/redis-password/password
{% if redis_tls_enabled %}
            - name: REDIS_EXPORTER_SKIP_TLS_VERIFICATION
              value: "false"
            - name: REDIS_EXPORTER_TLS_CLIENT_CERT_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }}
            - name: REDIS_EXPORTER_TLS_CLIENT_KEY_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }}
            - name: REDIS_EXPORTER_TLS_CA_CERT_FILE
              value: {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }}
{% endif %}
          volumeMounts:
            - name: redis-password
              mountPath: /run/redis-password
              readOnly: true
{% if redis_tls_enabled %}
            - name: redis-tls
              mountPath: {{ tls_cert_path }}
              readOnly: true
{% endif %}
          resources:
{{ redis_metrics_resources | to_nice_yaml(indent=12) | indent(10, False) }}
{% endif %}
{% if redis_node_selector %}
      nodeSelector:
{{ redis_node_selector | to_nice_yaml(indent=8) | indent(6, False) }}
{% else %}
      nodeSelector: {}
{% endif %}
{% if redis_tolerations %}
      tolerations:
{{ redis_tolerations | to_nice_yaml(indent=8) | indent(6, False) }}
{% else %}
      tolerations: []
{% endif %}
{% if redis_affinity %}
      affinity:
{{ redis_affinity | to_nice_yaml(indent=8) | indent(6, False) }}
{% else %}
      affinity: {}
{% endif %}
{% if redis_topology_spread_constraints %}
      topologySpreadConstraints:
{{ redis_topology_spread_constraints | to_nice_yaml(indent=8) | indent(6, False) }}
{% else %}
      topologySpreadConstraints: []
{% endif %}
      volumes:
        - name: redis-config
          configMap:
            name: {{ redis_configmap_name }}
        - name: redis-password
          secret:
            secretName: {{ redis_password_secret_name }}
            items:
              - key: {{ redis_password_secret_key }}
                path: password
{% if redis_acl_enabled %}
        - name: redis-acl
          secret:
            secretName: {{ redis_acl_secret_name }}
            items:
              - key: {{ redis_acl_secret_key }}
                path: users.acl
{% endif %}
{% if redis_tls_enabled %}
        - name: redis-tls
          secret:
            secretName: {{ redis_tls_cert_secret_name }}
{% endif %}
{% if not redis_persistence_enabled %}
        - name: redis-data
          emptyDir: {}
{% endif %}
{% if appendonly_enabled and redis_appendonlydir_name %}
        - name: redis-appendonlydir
{% if appendonly_k8s.medium or appendonly_k8s.size_limit %}
          emptyDir:
{% if appendonly_k8s.medium %}
            medium: {{ appendonly_k8s.medium }}
{% endif %}
{% if appendonly_k8s.size_limit %}
            sizeLimit: {{ appendonly_k8s.size_limit }}
{% endif %}
{% else %}
          emptyDir: {}
{% endif %}
{% endif %}
{% if redis_persistence_enabled %}
  volumeClaimTemplates:
    - metadata:
        name: redis-data
        labels:
{% for key, value in redis_labels.items() %}
          {{ key }}: {{ value }}
{% endfor %}
      spec:
        accessModes:
{% for mode in redis_access_modes %}
          - {{ mode }}
{% endfor %}
        resources:
          requests:
            storage: {{ redis_storage_size }}
{% if redis_storage_class %}
        storageClassName: {{ redis_storage_class }}
{% endif %}
{% endif %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ redis_service_name }}
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  type: ClusterIP
  ports:
{% if redis_enable_plaintext_port %}
    - name: redis
      port: {{ redis_port }}
      targetPort: redis
{% endif %}
{% if redis_tls_enabled %}
    - name: redis-tls
      port: {{ redis_tls_port }}
      targetPort: redis-tls
{% endif %}
  selector:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ redis_headless_service_name }}
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  ports:
{% if redis_enable_plaintext_port %}
    - name: redis
      port: {{ redis_port }}
      targetPort: redis
{% endif %}
{% if redis_tls_enabled %}
    - name: redis-tls
      port: {{ redis_tls_port }}
      targetPort: redis-tls
{% endif %}
  selector:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
---
{% if redis_enable_metrics %}
apiVersion: v1
kind: Service
metadata:
  name: {{ redis_service_name }}-metrics
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  type: ClusterIP
  ports:
    - name: metrics
      port: 9121
      targetPort: metrics
  selector:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
---
{% if redis_metrics_servicemonitor_enabled %}
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: {{ redis_name }}
  namespace: {{ redis_metrics_servicemonitor_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
{% for key, value in redis_metrics_servicemonitor_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  selector:
    matchLabels:
{% for key, value in redis_labels.items() %}
      {{ key }}: {{ value }}
{% endfor %}
  namespaceSelector:
    matchNames:
      - {{ redis_namespace }}
  endpoints:
    - port: metrics
      interval: {{ redis_metrics_servicemonitor_interval }}
      scheme: http
{% endif %}
---
{% endif %}
{% if redis_network_policy_enabled %}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ redis_name }}-ingress
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
  annotations:
    shma.dev/docs-url: {{ redis_docs_url | quote }}
    shma.dev/redis-access-label: 'shma.dev/redis-access="true"'
spec:
  podSelector:
    matchLabels:
{% for key, value in redis_labels.items() %}
      {{ key }}: {{ value }}
{% endfor %}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    - ports:
{% if redis_enable_plaintext_port %}
        - protocol: TCP
          port: {{ redis_port }}
{% endif %}
{% if redis_tls_enabled %}
        - protocol: TCP
          port: {{ redis_tls_port }}
{% endif %}
{% if redis_network_policy_allowed_peers %}
      from:
{% for peer in redis_network_policy_allowed_peers %}
        -
{% if peer.podSelector is defined %}
          podSelector:
{{ peer.podSelector | to_nice_yaml(indent=12) | indent(10, False) }}
{% endif %}
{% if peer.namespaceSelector is defined %}
          namespaceSelector:
{{ peer.namespaceSelector | to_nice_yaml(indent=12) | indent(10, False) }}
{% endif %}
{% if peer.ipBlock is defined %}
          ipBlock:
{{ peer.ipBlock | to_nice_yaml(indent=12) | indent(10, False) }}
{% endif %}
{% endfor %}
{% else %}
      from: []
{% endif %}
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ redis_network_policy_dns_namespace }}
{% if redis_network_policy_dns_selector %}
          podSelector:
            matchLabels:
{% for key, value in redis_network_policy_dns_selector.items() %}
              {{ key }}: {{ value }}
{% endfor %}
{% endif %}
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53
    - to:
{% if redis_network_policy_cluster_cidrs %}
{%   for cidr in redis_network_policy_cluster_cidrs %}
        - ipBlock:
            cidr: {{ cidr }}
{%   endfor %}
{% else %}
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ redis_namespace }}
{% endif %}
{% endif %}
---
{% if redis_network_policy_enabled %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ redis_name }}-access-debug
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
data:
  requiredLabel: 'shma.dev/redis-access="true"'
  discoveredPods: |
{% if redis_network_policy_access_pods | length > 0 %}
{%   for pod in redis_network_policy_access_pods %}
    {{ pod }}
{%   endfor %}
{% else %}
    (none discovered; run `kubectl get pods -A -l shma.dev/redis-access=true`)
{% endif %}
---
{% endif %}
{% if redis_backup_enabled %}
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ redis_name }}-backup
  namespace: {{ redis_namespace }}
  labels:
{% for key, value in redis_labels.items() %}
    {{ key }}: {{ value }}
{% endfor %}
spec:
  schedule: {{ redis_backup_schedule | quote }}
  jobTemplate:
    spec:
      template:
        metadata:
          labels:
{% for key, value in redis_labels.items() %}
            {{ key }}: {{ value }}
{% endfor %}
        spec:
          restartPolicy: OnFailure
          containers:
            - name: redis-backup
              image: {{ redis_backup_image }}
              command:
{% if redis_backup_command %}
{{ redis_backup_command | to_nice_yaml(indent=16) | indent(14, False) }}
{% else %}
                - /bin/sh
                - -c
                - >-
                  REDIS_PASSWORD="$(cat /run/redis-password/password)" &&
{% if redis_tls_enabled %}
                  redis-cli --tls --cert {{ tls_cert_path }}/{{ redis_tls_cert_secret_cert_key }} --key {{ tls_cert_path }}/{{ redis_tls_cert_secret_key_key }} --cacert {{ tls_cert_path }}/{{ redis_tls_cert_secret_ca_key }} -a "$REDIS_PASSWORD" -h {{ redis_service_name }} -p {{ redis_tls_port }} --rdb /backup/dump-$(date +%Y%m%d%H%M%S).rdb
{% else %}
                  redis-cli -a "$REDIS_PASSWORD" -h {{ redis_service_name }} -p {{ redis_port }} --rdb /backup/dump-$(date +%Y%m%d%H%M%S).rdb
{% endif %}
              volumeMounts:
                - name: redis-password
                  mountPath: /run/redis-password
                  readOnly: true
                - name: redis-backup
                  mountPath: /backup
{% if redis_tls_enabled %}
                - name: redis-tls
                  mountPath: {{ tls_cert_path }}
                  readOnly: true
{% endif %}
{% if redis_backup_extra_env %}
              env:
{% for key, value in redis_backup_extra_env.items() %}
                - name: {{ key }}
{%   if value is mapping and value.secret_name is defined %}
                  valueFrom:
                    secretKeyRef:
                      name: {{ value.secret_name }}
                      key: {{ value.secret_key | default(value.key) }}
{%   else %}
                  value: {{ value | quote }}
{%   endif %}
{% endfor %}
{% endif %}
          volumes:
            - name: redis-password
              secret:
                secretName: {{ redis_password_secret_name }}
                items:
                  - key: {{ redis_password_secret_key }}
                    path: password
            - name: redis-backup
              persistentVolumeClaim:
                claimName: {{ redis_backup_pvc_name }}
{% if redis_tls_enabled %}
            - name: redis-tls
              secret:
                secretName: {{ redis_tls_cert_secret_name }}
{% endif %}
{% endif %}
